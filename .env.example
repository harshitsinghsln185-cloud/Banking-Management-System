# Database
MONGODB_URI=mongodb://localhost:27017/aurelia_bank

# Authentication & Security
JWT_SECRET=your-at-least-32-chars-long-jwt-secret-key-here
CRON_SECRET=your-cron-secret-token
KYC_ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here

# Admin Credentials
